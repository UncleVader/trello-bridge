# Trello credentials (https://trello.com/power-ups/admin). The bridge reads
# the nearest .env in this directory or any parent; real env vars win.
TRELLO_KEY=
TRELLO_TOKEN=

# No board env var here on purpose: the bridge has no configured/default
# board. Every /cards request supplies its own board via the required
# X-Trello-Board header (percent-encoded) — see README.md.

# Local HTTP port. The server binds to 127.0.0.1 only.
#PORT=4646
